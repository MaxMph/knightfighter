window/size/viewport_height=540
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"
mouse_cursor/custom_image="uid://bgqea757bg2x0"
mouse_cursor/custom_image_hotspot=Vector2(8, 8)

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg")

[filesystem]

